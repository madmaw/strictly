{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/.astro/**",
    "**/.out/**",
    "**/dist/**",
    "**/locales/**",
    "**/storybook-static/**",
    "pnpm-lock.yaml"
  ],
  "jsxSingleQuote": true,
  "printWidth": 80,
  "semi": false,
  "singleAttributePerLine": true,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      ["builtin", "external", "internal", "subpath", "unknown"],
      ["parent", "sibling", "index"]
    ],
    "newlinesBetween": false
  },
  "sortPackageJson": false,
  "trailingComma": "all"
}
