{
  "name": "@strictly/vitest",
  "version": "0.0.43",
  "description": "Vitest assertion helpers that narrow types",
  "keywords": [
    "vitest"
  ],
  "homepage": "https://github.com/madmaw/strictly/tree/main/support/vitest",
  "license": "MIT",
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git",
    "directory": "support/vitest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp build --configLoader runner",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "@strictly/typescript": "workspace:*",
    "@strictly/vite": "workspace:*",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vitest": "^5.0.1"
  }
}
