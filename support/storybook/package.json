{
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "description": "Storybook configuration and assertion helpers for React, Mantine, MobX and Lingui",
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@mantine/core": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@strictly/typescript": "workspace:*",
    "@strictly/vite": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "mobx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "vite-plus": "catalog:"
  },
  "exports": {
    ".": "./src/index.ts",
    "./main": "./src/main.ts"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/madmaw/strictly/tree/main/support/storybook",
  "keywords": [
    "storybook"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@strictly/storybook",
  "peerDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@mantine/core": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "mobx": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./main": {
        "import": {
          "types": "./dist/main.d.ts",
          "default": "./dist/main.js"
        },
        "require": {
          "types": "./dist/main.d.cts",
          "default": "./dist/main.cjs"
        }
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "support/storybook",
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "vp build --configLoader runner",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out"
  },
  "type": "module",
  "version": "0.0.41"
}
