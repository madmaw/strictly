{
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.1.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "any-eslint-parser": "^1.0.1",
    "cross-env": "^7.0.3",
    "del-cli": "^6.0.0",
    "eslint": "^9.13.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-parser-plain": "^0.1.0",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-dprint-integration2": "^0.4.4",
    "eslint-plugin-import": "^2.30.0",
    "eslint-plugin-import-newlines": "^1.4.0",
    "eslint-plugin-jsonc": "^2.16.0",
    "eslint-plugin-no-autofix": "^2.0.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-no-relative-import-paths": "^1.5.3",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-yml": "^1.15.0",
    "typescript": "~5.7.3",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^2.1.3",
    "vitest-mock-extended": "^2.0.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.13.1"
  },
  "license": "MIT",
  "main": "index.js",
  "name": "@strictly/strictly",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "clean": "pnpm -r clean",
    "demo:build": "pnpm -r --filter @strictly/demo build",
    "demo:dev": "pnpm -r --filter @strictly/demo dev",
    "demo:storybook": "pnpm -r --filter @strictly/demo storybook",
    "docs:build": "pnpm -r --filter @strictly/docs build",
    "docs:dev": "pnpm -r --filter @strictly/docs dev",
    "lingui:compile": "pnpm -r lingui:compile",
    "lingui:extract": "pnpm -r lingui:extract",
    "lint": "pnpm -r --no-bail lint && pnpm lint:root",
    "lint:fix": "pnpm -r --no-bail lint:fix && pnpm lint:root:fix",
    "lint:root": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --max-warnings=0 *.cjs *.json .github",
    "lint:root:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint --fix *.cjs *.json .github",
    "react-form:storybook": "pnpm -r --filter @strictly/react-form storybook",
    "release:exports": "pnpm -r release:exports",
    "storybook:build": "pnpm -r storybook:build",
    "storybook:test": "pnpm -r --workspace-concurrency=1 storybook:test",
    "test": "pnpm -r test",
    "test:update": "pnpm -r test:update"
  },
  "version": "0.0.41"
}
