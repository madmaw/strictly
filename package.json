{
  "devDependencies": {
    "@strictly/oxlint": "workspace:*",
    "@typescript/native": "catalog:",
    "del-cli": "^7.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-mock-extended": "catalog:"
  },
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10.13.1"
  },
  "license": "MIT",
  "main": "index.js",
  "name": "@strictly/strictly",
  "packageManager": "pnpm@10.13.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check-types": "pnpm -r check-types",
    "clean": "pnpm -r clean",
    "demo:build": "pnpm -r --filter @strictly/demo build",
    "demo:dev": "pnpm -r --filter @strictly/demo dev",
    "demo:storybook": "pnpm -r --filter @strictly/demo storybook",
    "docs:build": "pnpm -r --filter @strictly/docs build",
    "docs:dev": "pnpm -r --filter @strictly/docs dev",
    "lingui:extract": "pnpm -r lingui:extract",
    "lint": "pnpm lint:format && pnpm -r --no-bail lint && pnpm lint:root",
    "lint:fix": "pnpm lint:format:fix && pnpm -r --no-bail lint:fix && pnpm lint:root:fix",
    "lint:format": "oxfmt --check",
    "lint:format:fix": "oxfmt",
    "lint:root": "oxlint --type-aware oxlint.config.ts",
    "lint:root:fix": "oxlint --type-aware --fix oxlint.config.ts",
    "react-form:storybook": "pnpm -r --filter @strictly/react-form storybook",
    "storybook:build": "pnpm -r storybook:build",
    "test": "pnpm -r test",
    "test:storybook": "pnpm -r --workspace-concurrency=1 test:storybook",
    "test:update": "pnpm -r test:update"
  },
  "type": "module",
  "version": "0.0.41"
}
