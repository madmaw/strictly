{
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@mantine/core": "catalog:",
    "@mantine/hooks": "catalog:",
    "@strictly/base": "workspace:*",
    "@strictly/define": "workspace:*",
    "@strictly/react-form": "workspace:*",
    "@strictly/spec": "workspace:*",
    "emulate-tab": "^1.2.1",
    "mobx": "catalog:",
    "mobx-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@lingui/cli": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@strictly/lingui": "workspace:*",
    "@strictly/spec": "workspace:*",
    "@strictly/vite": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "postcss": "^8.4.47",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "storybook": "catalog:",
    "typescript-plugin-css-modules": "^5.1.0",
    "vite": "catalog:"
  },
  "license": "MIT",
  "name": "@strictly/demo",
  "scripts": {
    "build": "pnpm lingui:compile && vite build",
    "check-types": "pnpm lingui:compile && tsc -b",
    "clean": "del-cli dist .out src/locales/*.ts",
    "dev": "pnpm lingui:compile && vite",
    "lingui": "pnpm lingui:extract && pnpm lingui:compile",
    "lingui:compile": "lingui compile --typescript",
    "lingui:extract": "lingui extract",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --max-warnings=0",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --fix",
    "preview": "vite preview",
    "storybook": "pnpm lingui:compile && storybook dev",
    "storybook:build": "pnpm lingui:compile && storybook build",
    "storybook:test": "pnpm exec playwright install chromium && pnpm lingui:compile && pnpm vitest:run --project=storybook/test",
    "test": "pnpm lingui:compile && pnpm vitest:run --project=unit/*",
    "test:update": "pnpm lingui:compile && pnpm vitest:run -u --project=unit/*",
    "test:watch": "pnpm vitest:run --watch --project=unit/*",
    "vitest:run": "vitest run --configLoader runner"
  },
  "version": "0.0.41"
}
