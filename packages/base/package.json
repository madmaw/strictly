{
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "devDependencies": {
    "@strictly/vite": "workspace:*",
    "type-fest": "catalog:"
  },
  "homepage": "https://madmaw.github.io/strictly/base",
  "keywords": [
    "react",
    "state management",
    "types"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@strictly/base",
  "peerDependencies": {
    "type-fest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "packages/base",
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "vp build --configLoader runner",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "test": "vp test run --configLoader runner",
    "test:watch": "vp test --configLoader runner"
  },
  "type": "module",
  "version": "0.0.41"
}
