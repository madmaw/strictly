{
  "name": "@strictly/base",
  "version": "0.0.42",
  "keywords": [
    "react",
    "state management",
    "types"
  ],
  "homepage": "https://madmaw.github.io/strictly/base",
  "license": "MIT",
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git",
    "directory": "packages/base"
  },
  "files": [
    "dist",
    "EXTERNAL.md"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp build --configLoader runner",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "test": "vp test run --configLoader runner",
    "test:watch": "vp test watch --configLoader runner",
    "version:patch": "npm version patch --no-git-tag-version"
  },
  "devDependencies": {
    "@strictly/typescript": "workspace:*",
    "@strictly/vite": "workspace:*",
    "@strictly/vitest": "workspace:*",
    "mobx-utils": "catalog:",
    "real-cancellable-promise": "catalog:",
    "type-fest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "mobx": "catalog:",
    "mobx-utils": "catalog:",
    "real-cancellable-promise": "catalog:",
    "type-fest": "catalog:",
    "zod": "^4.0.16"
  }
}
