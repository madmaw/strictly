{
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "description": "Types and utilities for creating React forms",
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@strictly/base": "workspace:*",
    "@strictly/define": "workspace:*",
    "@strictly/vite": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "type-fest": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "homepage": "https://madmaw.github.io/strictly/form",
  "keywords": [
    "react",
    "state management",
    "types"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@strictly/react-form",
  "peerDependencies": {
    "@mantine/core": "^9.0.0",
    "@mantine/hooks": "^9.0.0",
    "@strictly/base": "*",
    "@strictly/define": "*",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "mobx": "^7.0.0",
    "mobx-react": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",

          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",

          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "packages/react-form",
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "vp build --configLoader runner",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "storybook": "storybook dev",
    "storybook:build": "storybook build",
    "test": "vp test run --configLoader runner --project=unit/*",
    "test:storybook": "playwright install chromium && vp test run --configLoader runner --project=storybook/test",
    "test:update": "vp test run --configLoader runner -u --project=unit/*",
    "test:watch": "vp test watch --configLoader runner --project=unit/*"
  },
  "type": "module",
  "version": "0.0.41"
}
