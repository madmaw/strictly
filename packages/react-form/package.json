{
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "description": "Types and utilities for creating React forms",
  "devDependencies": {
    "@chromatic-com/storybook": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@strictly/base": "workspace:*",
    "@strictly/define": "workspace:*",
    "@strictly/oxlint": "workspace:*",
    "@strictly/vite": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "type-fest": "catalog:",
    "vite": "catalog:"
  },
  "homepage": "https://madmaw.github.io/strictly/form",
  "keywords": [
    "react",
    "state management",
    "types"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@strictly/react-form",
  "peerDependencies": {
    "@mantine/core": "^7.0.0 || ^8.0.0",
    "@mantine/hooks": "^7.0.0 || ^8.0.0",
    "@strictly/base": "*",
    "@strictly/define": "*",
    "@types/react": "^19.0.0 || ^18.0.0",
    "@types/react-dom": "^19.0.0 || ^18.0.0",
    "mobx": "^6.0.0",
    "mobx-react": "^9.1.1",
    "react": "^19.0.0 || ^18.0.0",
    "react-dom": "^19.0.0 || ^18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "packages/react-form",
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "vite build --configLoader runner",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "storybook": "storybook dev",
    "storybook:build": "storybook build",
    "test": "pnpm vitest:run --project=unit/*",
    "test:storybook": "pnpm exec playwright install chromium && pnpm vitest:run --project=storybook/test",
    "test:update": "pnpm vitest:run -u --project=unit/*",
    "test:watch": "pnpm vitest:run --watch --project=unit/*",
    "vitest:run": "vitest run --configLoader runner"
  },
  "type": "module",
  "version": "0.0.41"
}
