{
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "dependencies": {
  },
  "description": "Types and utilities for creating React forms",
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-proposal-decorators": "catalog:",
    "@babel/plugin-transform-class-static-block": "catalog:",
    "@storybook/addon-actions": "catalog:",
    "@storybook/addon-essentials": "catalog:",
    "@storybook/addon-interactions": "catalog:",
    "@storybook/addon-links": "catalog:",
    "@storybook/blocks": "catalog:",
    "@storybook/builder-vite": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@storybook/test": "catalog:",
    "@storybook/test-runner": "catalog:",
    "@strictly/base": "workspace:*",
    "@strictly/define": "workspace:*",
    "@strictly/support-vite": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^9.1.2",
    "jsdom": "catalog:",
    "resize-observer-polyfill": "catalog:",
    "storybook": "catalog:",
    "type-fest": "catalog:",
    "vite": "catalog:",
    "vitest-matchmedia-mock": "catalog:"
  },
  "homepage": "https://madmaw.github.io/strictly/form",
  "keywords": [
    "react",
    "state management",
    "types"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@strictly/react-form",
  "peerDependencies": {
    "@mantine/core": "^7.0.0 || ^8.0.0",
    "@mantine/hooks": "^7.0.0 || ^8.0.0",
    "@strictly/base": "*",
    "@strictly/define": "*",
    "@types/react": "^19.0.0 || ^18.0.0",
    "@types/react-dom": "^19.0.0 || ^18.0.0",
    "mobx": "^6.0.0",
    "mobx-react": "^9.1.1",
    "react": "^19.0.0 || ^18.0.0",
    "react-dom": "^19.0.0 || ^18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "packages/react-form",
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "vite build",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --max-warnings=0",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --fix",
    "storybook": "storybook dev",
    "storybook:build": "storybook build",
    "storybook:test": "pnpm exec playwright install && pnpm storybook:build && concurrently -k -s first -n \"SB,TEST\" \"npx http-server storybook-static --port 6006 --silent\" \"npx wait-on tcp:127.0.0.1:6006 && pnpm storybook:test:client\"",
    "storybook:test:client": "test-storybook",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "test:watch": "vitest"
  },
  "type": "module",
  "version": "0.0.41"
}
