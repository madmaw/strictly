{
  "author": "Chris <chris.glover@gmail.com> (@madmaw)",
  "dependencies": {
    "@lingui/core": "catalog:",
    "@lingui/react": "catalog:",
    "@strictly/base": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "description": "Helper utilities for testing",
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "resize-observer-polyfill": "catalog:",
    "storybook": "catalog:",
    "vite": "catalog:",
    "vitest-matchmedia-mock": "catalog:"
  },
  "homepage": "https://madmaw.github.io/strictly/spec",
  "keywords": [
    "react",
    "state management",
    "types"
  ],
  "license": "MIT",
  "main": "src/index.ts",
  "name": "@strictly/spec",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "repository": {
    "directory": "packages/spec",
    "type": "git",
    "url": "git+https://github.com/madmaw/strictly.git"
  },
  "scripts": {
    "build": "vite build",
    "check-types": "tsc -b",
    "clean": "del-cli dist .out",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --max-warnings=0",
    "lint:fix": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint . --fix"
  },
  "type": "module",
  "version": "0.0.41"
}
