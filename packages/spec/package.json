    "@strictly/base": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "description": "Helper utilities for testing",
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "resize-observer-polyfill": "catalog:",
    "storybook": "catalog:",
